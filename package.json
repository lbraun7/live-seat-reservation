{
  "name": "live-seat-reservation",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de reserva de assentos para flash sales",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/apps/api/main.ts",
    "start": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "start:outbox-relay": "node dist/apps/outbox-relay/main.js",
    "start:websocket-gateway": "node dist/apps/websocket-gateway/main.js",
    "start:admission-controller": "node dist/apps/admission-controller/main.js",
    "dev:worker": "tsx watch src/apps/worker/main.ts",
    "dev:outbox-relay": "tsx watch src/apps/outbox-relay/main.ts",
    "dev:websocket-gateway": "tsx watch src/apps/websocket-gateway/main.ts",
    "dev:admission-controller": "tsx watch src/apps/admission-controller/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "migrate": "tsx src/shared/database/migrate.ts",
    "seed": "tsx src/apps/seed/main.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.41",
    "bullmq": "^5.81.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.14"
  }
}
